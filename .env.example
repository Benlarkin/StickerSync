# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications (Bot tab)
DISCORD_BOT_TOKEN=

# Right-click your server > Copy Server ID (needs Developer Mode)
DISCORD_GUILD_ID=

# Optional
# STICKERSYNC_HOME=~/.stickersync
# STICKERSYNC_DEFAULT_TAG=sparkles
# STICKERSYNC_DESCRIPTION=Synced from TikTok by StickerSync
